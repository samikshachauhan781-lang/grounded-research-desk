# Application
APP_NAME=grounded-research-desk
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# Database
DATABASE_URL=sqlite:///./data/grounded_research.db

# Upload limits
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# Chunking
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120

# Retrieval
RETRIEVAL_TOP_K=5
MIN_SIMILARITY_SCORE=0.25
EVIDENCE_MIN_LEXICAL_OVERLAP=0.15

# Generation
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GENERATION_TIMEOUT_SECONDS=60

# Agent (Phase 4+)
AGENT_ENABLED=false
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_WALL_CLOCK_SECONDS=120

# Embeddings (fake = offline tests; local = sentence-transformers)
EMBEDDING_PROVIDER=fake

# CORS (frontend dev server)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Paths
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Demo / safety
DEMO_MODE=false
